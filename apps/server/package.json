    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@solidloom/cad-engine": "0.1.0",
    "@solidloom/shared": "0.1.0",
    "fastify": "^5.6.1"
  }
}
